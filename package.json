{
  "name": "lecstor-com",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "wrangler types && vite build && tsc --noEmit",
    "preview": "pnpm build && vite preview --port 3000",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply lecstor-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply lecstor-db --remote",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\""
  },
  "dependencies": {
    "@content-collections/core": "^0.15.0",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/vite": "^0.3.0",
    "@stylexjs/stylex": "^0.18.3",
    "@tanstack/react-router": "1.163.2",
    "@tanstack/react-router-devtools": "1.163.2",
    "@tanstack/react-start": "1.163.2",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@stylexjs/unplugin": "^0.18.3",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.74.0",
    "zod": "^4.3.6"
  }
}
